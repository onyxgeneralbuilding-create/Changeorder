# Copy this file to .env and fill in the values.

# Public address of this app — used in the links sent to customers.
APP_URL=http://localhost:3000
PORT=3000

# Password for you / your office to log in to the dashboard.
ADMIN_PASSWORD=change-me
# Any long random string (used to secure login cookies).
SESSION_SECRET=replace-with-a-long-random-string

# ---------- Email (Gmail example) ----------
# In your Google account: Security > 2-Step Verification > App passwords.
# Create an app password and paste it below (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=onyxgeneralbuilding@gmail.com
SMTP_PASS=
EMAIL_FROM=onyxgeneralbuilding@gmail.com
# Name shown as the sender in customers' inboxes.
EMAIL_FROM_NAME=Onyx General Building
# Where "customer signed" notifications go.
NOTIFY_EMAIL=onyxgeneralbuilding@gmail.com

